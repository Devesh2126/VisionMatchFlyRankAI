# Application
PROJECT_NAME="VisionMatch AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="dev-secret-key-change-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
POSTGRES_USER=visionmatch
POSTGRES_PASSWORD=visionmatch_pass
POSTGRES_DB=visionmatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://visionmatch:visionmatch_pass@localhost:5432/visionmatch_db

# Redis (Broker & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_pass
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=visionmatch-assets
MINIO_SECURE=false

# ML & MLOps Configuration
DEFAULT_MODEL_KEY=clip-vit-b32
HF_HOME=./.cache/huggingface
MLFLOW_TRACKING_URI=http://localhost:5000